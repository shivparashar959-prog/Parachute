# DocGuard Backend Environment Variables (Example)
# Copy this file to .env for local configuration. Never commit real secrets!

APP_NAME=DocGuard
APP_VERSION=0.1.0
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS Configuration
# With no explicit origins, localhost development origins are allowed.
# Set CORS_ALLOWED_ORIGINS to a comma-separated deployment allowlist; configured
# origins replace the localhost defaults. FRONTEND_ORIGIN is also accepted.
# ALLOWED_ORIGINS remains as a legacy alias when CORS_ALLOWED_ORIGINS is empty.
# Wildcard (*) is never permitted when credentials are enabled.
FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=

# Git Operation Timeout (seconds) for clone, fetch, history, and diff commands
GIT_OPERATION_TIMEOUT_SECONDS=45

# Milestone 6: AI Provider Configuration (Google Gemini API)
# Leave GEMINI_API_KEY empty to use deterministic Mock AI Mode without external API calls.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
