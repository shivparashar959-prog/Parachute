# DocGuard Backend Environment Variables (Example)
# Copy this file to .env for local configuration. Never commit real secrets!

APP_NAME=DocGuard
APP_VERSION=0.1.0
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# PostgreSQL (replace USER/PASSWORD with your local PostgreSQL role)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/docguard

# GitHub OAuth sign-in (account identity only; not repository authorization)
# Register the exact callback URL configured below in your GitHub OAuth App.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback
# Generate a random secret of at least 32 characters; leave blank until configured.
GITHUB_OAUTH_STATE_SECRET=

# GitHub App repository authorization (separate from account sign-in above)
# Register these exact callback URLs in the GitHub App settings.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Keep the private key in a deployment secret store; escaped \n is accepted.
GITHUB_APP_PRIVATE_KEY=
# Set a random webhook secret of at least 32 characters.
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SETUP_URL=http://localhost:8000/api/github/installations/callback
GITHUB_APP_USER_CALLBACK_URL=http://localhost:8000/api/github/user-callback

# Browser session cookies
SESSION_COOKIE_NAME=docguard_session
SESSION_TTL_SECONDS=43200
# Set false only for local HTTP development. Production requires true.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# CORS Configuration
# With no explicit origins, localhost development origins are allowed only in development.
# Set CORS_ALLOWED_ORIGINS to a comma-separated deployment allowlist; configured
# origins replace the localhost defaults. FRONTEND_ORIGIN is also accepted.
# ALLOWED_ORIGINS remains as a legacy alias when CORS_ALLOWED_ORIGINS is empty.
# Wildcard (*) is never permitted when credentials are enabled.
FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=

# Git Operation Timeout (seconds) for clone, fetch, history, and diff commands
GIT_OPERATION_TIMEOUT_SECONDS=45

# Analysis resource, concurrency, and request quotas
ANALYSIS_PER_USER_HOUR_LIMIT=10
ANALYSIS_PER_WORKSPACE_DAY_LIMIT=100
ANALYSIS_MAX_CONCURRENT_PER_WORKSPACE=2
ANALYSIS_TIMEOUT_SECONDS=180
ANALYSIS_RETRY_MAX_ATTEMPTS=3

# Celery broker. Local Redis is for development; production must use a private,
# authenticated Redis endpoint with TLS (rediss://). Queue messages contain IDs only.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Optional worker-local scratch root. Keep this on an isolated, size-limited volume.
DOCGUARD_SCRATCH_ROOT=

# Google Gemini (required in production; Mock is development/test only)
# Finding evidence is sent to Google Gemini only when the user explicitly selects it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PROVIDER_TIMEOUT_MS=20000
GEMINI_MAX_OUTPUT_TOKENS=512
# Configure positive values using current Gemini model pricing before enabling Gemini.
GEMINI_DAILY_BUDGET_USD=0
GEMINI_USER_DAILY_BUDGET_USD=0
GEMINI_INPUT_USD_PER_MILLION_TOKENS=0
GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=0
